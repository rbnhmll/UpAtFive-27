{% doc %}
  Site-wide JSON-LD structured data, rendered once in the <head>.

  - Every page: Organization + WebSite.
  - Project pages: CreativeWork (the case study) + BreadcrumbList.
  - Service pages: Service + BreadcrumbList.

  Breadcrumb parents come from Theme settings → SEO (the Our Work / Services pages).
  Products and articles keep their own structured data in their sections.
{% enddoc %}
{%- liquid
  assign org_id = request.origin | append: '/#organization'
  assign site_id = request.origin | append: '/#website'
  assign home_url = request.origin | append: routes.root_url

  # Social profiles: only the ones that are filled in.
  assign social_keys = 'social_instagram_link,social_facebook_link,social_twitter_link,social_youtube_link,social_tiktok_link,social_pinterest_link,social_vimeo_link,social_tumblr_link,social_snapchat_link,seo_linkedin_link' | split: ','
  assign social_links = ''
  for key in social_keys
    assign link = settings[key] | strip
    if link != blank
      assign social_links = social_links | append: link | append: '|~|'
    endif
  endfor
  assign social_links = social_links | split: '|~|'

  assign entry_type = ''
  if metaobject
    assign entry_type = metaobject.system.type
  endif

  # Main image for the current metaobject page (projects: image_main, services: share/hero image).
  assign entry_image = nil
  if entry_type == 'project'
    assign entry_image = metaobject.image_main.value
  elsif entry_type == 'service'
    assign entry_image = metaobject.share_image.value | default: metaobject.hero_image.value
  endif
  if entry_image != blank and entry_image.media_type != 'image'
    assign entry_image = entry_image.preview_image
  endif

  assign entry_description = ''
  if metaobject.summary != blank
    assign entry_description = metaobject.summary | metafield_text | strip_html | strip_newlines | strip
  endif
-%}
<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Organization",
        "@id": {{ org_id | json }},
        "name": {{ shop.name | json }},
        "url": {{ home_url | json }}
        {%- if settings.logo != blank -%}
          ,"logo": {{ settings.logo | image_url: width: 500 | prepend: 'https:' | json }}
        {%- endif -%}
        {%- if shop.description != blank -%}
          ,"description": {{ shop.description | json }}
        {%- endif -%}
        {%- if social_links.size > 0 -%}
          ,"sameAs": [
            {%- for link in social_links -%}
              {{ link | json }}{% unless forloop.last %},{% endunless %}
            {%- endfor -%}
          ]
        {%- endif %}
      },
      {
        "@type": "WebSite",
        "@id": {{ site_id | json }},
        "url": {{ home_url | json }},
        "name": {{ shop.name | json }},
        "publisher": { "@id": {{ org_id | json }} }
      }

      {%- if entry_type == 'project' or entry_type == 'service' -%}
        {%- liquid
          if entry_type == 'project'
            assign parent_page = settings.seo_projects_page
          else
            assign parent_page = settings.seo_services_page
          endif
          assign entry_name = metaobject.title.value | default: page_title
        -%}
        ,{
          {%- if entry_type == 'project' -%}
            "@type": "CreativeWork",
            "genre": "Case study",
          {%- else -%}
            "@type": "Service",
            "serviceType": {{ entry_name | json }},
            "provider": { "@id": {{ org_id | json }} },
          {%- endif %}
          "@id": {{ canonical_url | append: '#main' | json }},
          "name": {{ entry_name | json }},
          "url": {{ canonical_url | json }}
          {%- if entry_description != blank -%}
            ,"description": {{ entry_description | json }}
          {%- endif -%}
          {%- if entry_image != blank -%}
            ,"image": {{ entry_image | image_url: width: 1200 | prepend: 'https:' | json }}
          {%- endif -%}
          {%- if entry_type == 'project' -%}
            ,"creator": { "@id": {{ org_id | json }} }
            ,"publisher": { "@id": {{ org_id | json }} }
            {%- if metaobject.launch_date != blank -%}
              ,"dateCreated": {{ metaobject.launch_date.value | date: '%Y-%m-%d' | json }}
            {%- endif -%}
            {%- if metaobject.client_name != blank -%}
              ,"about": {
                "@type": "Organization",
                "name": {{ metaobject.client_name.value | json }}
                {%- if metaobject.store_url != blank -%}
                  ,"url": {{ metaobject.store_url.value | json }}
                {%- endif %}
              }
            {%- endif -%}
            {%- liquid
              assign keywords = ''
              if metaobject.industry != blank
                assign keywords = metaobject.industry | metafield_text
              endif
              for service in metaobject.services.value
                assign keywords = keywords | append: ', ' | append: service.title.value
              endfor
              for tech in metaobject.tech_stack.value
                assign keywords = keywords | append: ', ' | append: tech
              endfor
              assign keywords = keywords | remove_first: ', '
            -%}
            {%- if keywords != blank -%}
              ,"keywords": {{ keywords | json }}
            {%- endif -%}
          {%- else -%}
            {%- if metaobject.deliverables != blank -%}
              ,"hasOfferCatalog": {
                "@type": "OfferCatalog",
                "name": {{ entry_name | append: ' deliverables' | json }},
                "itemListElement": [
                  {%- for item in metaobject.deliverables.value -%}
                    {
                      "@type": "Offer",
                      "itemOffered": { "@type": "Service", "name": {{ item | json }} }
                    }{% unless forloop.last %},{% endunless %}
                  {%- endfor -%}
                ]
              }
            {%- endif -%}
          {%- endif %}
        },
        {
          "@type": "BreadcrumbList",
          "itemListElement": [
            {
              "@type": "ListItem",
              "position": 1,
              "name": "Home",
              "item": {{ home_url | json }}
            },
            {%- if parent_page != blank -%}
              {
                "@type": "ListItem",
                "position": 2,
                "name": {{ parent_page.title | json }},
                "item": {{ request.origin | append: parent_page.url | json }}
              },
            {%- endif -%}
            {
              "@type": "ListItem",
              "position": {% if parent_page != blank %}3{% else %}2{% endif %},
              "name": {{ entry_name | json }},
              "item": {{ canonical_url | json }}
            }
          ]
        }
      {%- endif %}
    ]
  }
</script>
