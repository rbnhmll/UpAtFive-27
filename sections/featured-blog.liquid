{%- render 'section-anchor' -%}
{%- liquid
  # Cards are H3 under the section's H2; H2 when the section has no heading,
  # so the page outline never jumps from H1 to H3.
  assign card_heading_tag = 'h3'
  if section.settings.heading == blank
    assign card_heading_tag = 'h2'
  endif
-%}
{{ 'component-slider.css' | asset_url | stylesheet_tag }}
{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-article-card.css' | asset_url | stylesheet_tag }}
{{ 'section-featured-blog.css' | asset_url | stylesheet_tag }}
{%- if section.settings.source == 'projects' -%}
  {{ 'component-project-card.css' | asset_url | stylesheet_tag }}
{%- endif -%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  assign show_projects = false
  if section.settings.source == 'projects'
    assign show_projects = true
  endif

  if show_projects
    assign projects = section.settings.projects
    assign projects_count = section.settings.projects.count
    assign posts_displayed = projects_count
    assign slide_total = projects_count
    if projects_count > 1
      assign posts_exceed_limit = true
    endif
  else
    assign slide_total = section.settings.post_limit
    assign posts_displayed = section.settings.blog.articles_count
    if section.settings.post_limit <= section.settings.blog.articles_count or section.settings.post_limit <= 4
      assign posts_exceed_limit = true
      assign posts_displayed = section.settings.post_limit
    endif
  endif

  assign title_key = section.settings.project_title_field | strip
  assign image_key = section.settings.project_image_field | strip
  assign excerpt_key = section.settings.project_excerpt_field | strip
  assign link_key = section.settings.project_link_field | strip
  assign industry_key = ''
  if section.settings.show_industry
    assign industry_key = section.settings.project_industry_field | strip
  endif
-%}
<div class="blog color-{{ section.settings.color_scheme }} gradient{% if section.settings.heading == blank %} no-heading{% endif %}">
  <div class="page-width-desktop isolate{% if posts_displayed < 3 %} page-width-tablet{% endif %} section-{{ section.id }}-padding">
    {%- unless section.settings.heading == blank -%}
      <div class="title-wrapper-with-link{% if posts_displayed > 2 %} title-wrapper--self-padded-tablet-down{% else %} title-wrapper--self-padded-mobile{% endif %} title-wrapper--no-top-margin">
        <h2
          id="SectionHeading-{{ section.id }}"
          class="blog__title inline-richtext {{ section.settings.heading_size }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
          {% if settings.animations_reveal_on_scroll %}
            data-cascade
          {% endif %}
        >
          {{ section.settings.heading | replace: '[br]', '<br>' }}
        </h2>

        {%- if show_projects -%}
          {%- if section.settings.show_view_all and section.settings.projects_view_all_link != blank -%}
            <a
              href="{{ section.settings.projects_view_all_link }}"
              class="link underlined-link large-up-hide{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
            >
              {{ section.settings.projects_view_all_label | escape }}
            </a>
          {%- endif -%}
        {%- elsif section.settings.blog != blank
          and section.settings.show_view_all
          and section.settings.post_limit < section.settings.blog.articles_count
        -%}
          <a
            href="{{ section.settings.blog.url }}"
            class="link underlined-link large-up-hide{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
          >
            {{ 'sections.featured_blog.view_all' | t }}
          </a>
        {%- endif -%}
      </div>
    {%- endunless -%}

    <slider-component class="slider-mobile-gutter{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
      <ul
        id="Slider-{{ section.id }}"
        class="blog__posts articles-wrapper contains-card contains-card--article{% if settings.blog_card_style == 'standard' %} contains-card--standard{% endif %} grid grid--peek grid--2-col-tablet grid--{{ section.settings.columns_desktop }}-col-desktop slider {% if posts_displayed > 2 %}slider--tablet{% else %}slider--mobile{% endif %}"
        role="list"
      >
        {%- if show_projects and projects_count > 0 -%}
          {%- for project in projects -%}
            <li
              id="Slide-{{ section.id }}-{{ forloop.index }}"
              class="blog__post grid__item article slider__slide slider__slide--full-width{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
              {% if settings.animations_reveal_on_scroll %}
                data-cascade
                style="--animation-order: {{ forloop.index }};"
              {% endif %}
            >
              {% render 'project-card',
              heading_tag: card_heading_tag,
                project: project,
                title_key: title_key,
                image_key: image_key,
                excerpt_key: excerpt_key,
                link_key: link_key,
                link_label: section.settings.project_link_label,
                industry_key: industry_key,
                text_alignment: section.settings.project_text_alignment,
                image_ratio: section.settings.project_image_ratio,
                show_image: section.settings.show_image,
                show_excerpt: true
              %}
            </li>
          {%- endfor -%}
        {%- elsif show_projects -%}
          {%- if request.design_mode -%}
            <li class="blog__post grid__item">
              <p>Choose case studies in the section settings.</p>
            </li>
          {%- endif -%}
        {%- elsif section.settings.blog != blank and section.settings.blog.articles_count > 0 -%}
          {%- for article in section.settings.blog.articles limit: section.settings.post_limit -%}
            <li
              id="Slide-{{ section.id }}-{{ forloop.index }}"
              class="blog__post grid__item article slider__slide slider__slide--full-width{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
              {% if settings.animations_reveal_on_scroll %}
                data-cascade
                style="--animation-order: {{ forloop.index }};"
              {% endif %}
            >
              {% render 'article-card',
                blog: section.settings.blog,
                article: article,
                media_aspect_ratio: 1.66,
                show_image: section.settings.show_image,
                show_date: section.settings.show_date,
                show_author: section.settings.show_author,
                show_excerpt: true
              %}
            </li>
          {%- endfor -%}
        {%- else -%}
          {% for i in (1..section.settings.post_limit) -%}
            {%- assign placeholder_image_index = forloop.index0 | modulo: 3 | plus: 1 -%}
            {%- assign placeholder_image = 'blog-apparel-' | append: placeholder_image_index -%}
            <li
              id="Slide-{{ section.id }}-{{ forloop.index }}"
              class="blog__post grid__item article slider__slide slider__slide--full-width{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
              {% if settings.animations_reveal_on_scroll %}
                data-cascade
                style="--animation-order: {{ forloop.index }};"
              {% endif %}
            >
              <div class="article-card-wrapper card-wrapper{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
                <div
                  class="
                    card article-card card--{{ settings.blog_card_style }}
                    {% if settings.blog_card_style == 'card' %} color-{{ settings.blog_card_color_scheme }} gradient{% endif %}
                    {% if section.settings.show_image %} card--media{% else %} card--text{% endif %}
                  "
                  style=" {% if settings.blog_card_style == 'standard' %} --ratio-percent: 100%;{% elsif settings.blog_card_style == 'card' %} --ratio-percent: 0%;{% endif %}"
                >
                  <div
                    class="card__inner{% if settings.blog_card_style == 'standard' %} color-{{ settings.blog_card_color_scheme }} gradient{% endif %} ratio"
                    style="--ratio-percent: 80%;"
                  >
                    {%- if section.settings.show_image == true -%}
                      <div class="article-card__image-wrapper card__media">
                        <div class="article-card__image media">
                          {{ placeholder_image | placeholder_svg_tag: 'blog-placeholder-svg' }}
                        </div>
                      </div>
                    {%- endif -%}
                    <div class="card__content">
                      <div class="card__information">
                        <h3 class="card__heading h2">
                          {{ 'sections.featured_blog.onboarding_title' | t }}
                        </h3>
                        <p class="article-card__excerpt rte-width">
                          {{ 'sections.featured_blog.onboarding_content' | t }}
                        </p>
                      </div>
                    </div>
                  </div>
                  <div class="card__content">
                    <div class="card__information">
                      <h3 class="card__heading h2">
                        {{ 'sections.featured_blog.onboarding_title' | t }}
                      </h3>
                      <p class="article-card__excerpt rte-width">
                        {{ 'sections.featured_blog.onboarding_content' | t }}
                      </p>
                    </div>
                  </div>
                </div>
              </div>
            </li>
          {%- endfor -%}
        {%- endif -%}
      </ul>
      {%- if posts_exceed_limit -%}
        <div class="slider-buttons{% if slide_total < 3 %} medium-hide{% endif %}{% if slide_total < 2 %} small-hide{% endif %}">
          <button
            type="button"
            class="slider-button slider-button--prev"
            name="previous"
            aria-label="{{ 'general.slider.previous_slide' | t }}"
          >
            <span class="svg-wrapper">
              {{- 'icon-caret.svg' | inline_asset_content -}}
            </span>
          </button>
          <div class="slider-counter caption">
            <span class="slider-counter--current">1</span>
            <span aria-hidden="true"> / </span>
            <span class="visually-hidden">{{ 'general.slider.of' | t }}</span>
            <span class="slider-counter--total">{{ slide_total }}</span>
          </div>
          <button
            type="button"
            class="slider-button slider-button--next"
            name="next"
            aria-label="{{ 'general.slider.next_slide' | t }}"
          >
            <span class="svg-wrapper">
              {{- 'icon-caret.svg' | inline_asset_content -}}
            </span>
          </button>
        </div>
      {%- endif -%}
    </slider-component>

    {%- liquid
      assign desktop_view_all_url = nil
      assign desktop_view_all_label = 'sections.featured_blog.view_all' | t
      if section.settings.show_view_all
        if show_projects
          if section.settings.projects_view_all_link != blank
            assign desktop_view_all_url = section.settings.projects_view_all_link
            assign desktop_view_all_label = section.settings.projects_view_all_label
          endif
        elsif section.settings.post_limit < section.settings.blog.articles_count
          assign desktop_view_all_url = section.settings.blog.url
        endif
      endif
    -%}
    {%- if desktop_view_all_url != blank -%}
      <div
        class="blog__view-all center small-hide medium-hide{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
        {% if settings.animations_reveal_on_scroll %}
          data-cascade
        {% endif %}
      >
        <a
          href="{{ desktop_view_all_url }}"
          id="ViewAll-{{ section.id }}"
          class="blog__button button"
          aria-labelledby="ViewAll-{{ section.id }} SectionHeading-{{ section.id }}"
        >
          {{ desktop_view_all_label | escape }}
        </a>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.featured-blog.name",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "select",
      "id": "source",
      "options": [
        { "value": "blog", "label": "Blog posts" },
        { "value": "projects", "label": "Case studies" }
      ],
      "default": "blog",
      "label": "Content source"
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "t:sections.featured-blog.settings.blog.label",
      "visible_if": "{{ section.settings.source == 'blog' }}"
    },
    {
      "type": "range",
      "id": "post_limit",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3,
      "label": "t:sections.featured-blog.settings.post_limit.label",
      "visible_if": "{{ section.settings.source == 'blog' }}"
    },
    {
      "type": "metaobject_list",
      "id": "projects",
      "metaobject_type": "project",
      "limit": 12,
      "label": "Case studies",
      "info": "Shown in the order selected",
      "visible_if": "{{ section.settings.source == 'projects' }}"
    },
    {
      "type": "url",
      "id": "projects_view_all_link",
      "label": "\"View all\" link",
      "visible_if": "{{ section.settings.source == 'projects' }}"
    },
    {
      "type": "text",
      "id": "projects_view_all_label",
      "default": "View all case studies",
      "label": "\"View all\" label",
      "visible_if": "{{ section.settings.source == 'projects' }}"
    },
    {
      "type": "select",
      "id": "project_text_alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left",
      "label": "Card text alignment",
      "visible_if": "{{ section.settings.source == 'projects' }}"
    },
    {
      "type": "select",
      "id": "project_image_ratio",
      "options": [
        { "value": "landscape", "label": "Landscape (3:2)" },
        { "value": "wide", "label": "Wide (16:9)" },
        { "value": "square", "label": "Square (1:1)" },
        { "value": "portrait", "label": "Portrait (4:5)" }
      ],
      "default": "landscape",
      "label": "Card image shape",
      "info": "Images are cropped to fill this shape so every card lines up",
      "visible_if": "{{ section.settings.source == 'projects' }}"
    },
    {
      "type": "text",
      "id": "project_link_label",
      "default": "View case study",
      "label": "Card link label",
      "info": "Leave blank to hide",
      "visible_if": "{{ section.settings.source == 'projects' }}"
    },
    {
      "type": "checkbox",
      "id": "show_industry",
      "default": true,
      "label": "Show industry badge",
      "visible_if": "{{ section.settings.source == 'projects' }}"
    },
    {
      "type": "header",
      "content": "t:sections.featured-blog.settings.text_header.content"
    },            
    {
      "type": "inline_richtext",
      "id": "heading",
      "default": "t:sections.featured-blog.settings.heading.default",
      "label": "t:sections.featured-blog.settings.heading.label",
      "info": "Type [br] for a line break"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h2",
          "label": "t:sections.all.heading_size.options__1.label"
        },
        {
          "value": "h1",
          "label": "t:sections.all.heading_size.options__2.label"
        },
        {
          "value": "h0",
          "label": "t:sections.all.heading_size.options__3.label"
        },
        {
          "value": "hxl",
          "label": "t:sections.all.heading_size.options__4.label"
        },
        {
          "value": "hxxl",
          "label": "t:sections.all.heading_size.options__5.label"
        }
      ],
      "default": "h1",
      "label": "t:sections.all.heading_size.label"
    },
    {
      "type": "header",
      "content": "t:sections.featured-blog.settings.layout_header.content"
    },        
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 3,
      "label": "t:sections.featured-blog.settings.columns_desktop.label"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "default": true,
      "label": "t:sections.featured-blog.settings.show_view_all.label",
      "info": "t:sections.featured-blog.settings.show_view_all.info"
    },    
    {
      "type": "checkbox",
      "id": "show_image",
      "default": true,
      "label": "t:sections.featured-blog.settings.show_image.label"
    },
    {
      "type": "checkbox",
      "id": "show_date",
      "default": true,
      "label": "t:sections.featured-blog.settings.show_date.label",
      "visible_if": "{{ section.settings.source == 'blog' }}"
    },
    {
      "type": "checkbox",
      "id": "show_author",
      "default": false,
      "label": "t:sections.featured-blog.settings.show_author.label",
      "visible_if": "{{ section.settings.source == 'blog' }}"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "info": "t:sections.all.colors.has_cards_info",
      "default": "scheme-1"
    },    
    {
      "type": "header",
      "content": "Case study fields"
    },
    {
      "type": "text",
      "id": "project_title_field",
      "default": "title",
      "label": "Title field key",
      "visible_if": "{{ section.settings.source == 'projects' }}"
    },
    {
      "type": "text",
      "id": "project_image_field",
      "default": "image_main",
      "label": "Image field key",
      "info": "Must be a file (image) field",
      "visible_if": "{{ section.settings.source == 'projects' }}"
    },
    {
      "type": "text",
      "id": "project_excerpt_field",
      "default": "summary",
      "label": "Summary field key",
      "info": "Single-line, multi-line or rich text",
      "visible_if": "{{ section.settings.source == 'projects' }}"
    },
    {
      "type": "text",
      "id": "project_link_field",
      "label": "Link field key",
      "info": "Only used if the Project definition doesn't have web pages turned on",
      "visible_if": "{{ section.settings.source == 'projects' }}"
    },
    {
      "type": "text",
      "id": "project_industry_field",
      "default": "industry",
      "label": "Industry field key",
      "info": "Text, list of text, or a reference to another metaobject (its name, title or label field is shown)",
      "visible_if": "{{ section.settings.source == 'projects' }}"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    },
    {
      "type": "header",
      "content": "In-page navigation"
    },
    {
      "type": "text",
      "id": "anchor_id",
      "label": "Section ID",
      "info": "Optional. Link to this section with #your-id (e.g. #services). Use a unique ID per page."
    }
  ],
  "presets": [
    {
      "name": "t:sections.featured-blog.presets.name"
    }
  ]
}
{% endschema %}
