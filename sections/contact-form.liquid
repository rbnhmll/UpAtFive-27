{%- render 'section-anchor' -%}
{{ 'section-contact-form.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="contact page-width page-width--narrow section-{{ section.id }}-padding">
    {%- if section.settings.heading != blank -%}
      <h2 class="title title-wrapper--no-top-margin inline-richtext {{ section.settings.heading_size }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
        {{ section.settings.heading }}
      </h2>
    {%- else -%}
      <h2 class="visually-hidden">{{ 'templates.contact.form.title' | t }}</h2>
    {%- endif -%}
    {%- liquid
      assign contact_form_class = 'isolate'
      if settings.animations_reveal_on_scroll
        assign contact_form_class = 'isolate scroll-trigger animate--slide-in'
      endif
    -%}
    {%- form 'contact', id: 'ContactForm', class: contact_form_class -%}
      {%- if form.posted_successfully? -%}
        <h2 class="form-status form-status-list form__message" tabindex="-1" autofocus>
          {{- 'icon-success.svg' | inline_asset_content -}}
          {{ 'templates.contact.form.post_success' | t }}
        </h2>
      {%- elsif form.errors -%}
        <div class="form__message">
          <h2 class="form-status caption-large text-body" role="alert" tabindex="-1" autofocus>
            {{- 'icon-error.svg' | inline_asset_content -}}
            {{ 'templates.contact.form.error_heading' | t }}
          </h2>
        </div>
        <ul class="form-status-list caption-large" role="list">
          <li>
            <a href="#ContactForm-email" class="link">
              {{ form.errors.translated_fields.email | capitalize }}
              {{ form.errors.messages.email }}
            </a>
          </li>
        </ul>
      {%- endif -%}
      <div class="contact__fields">
        <div class="field">
          <input
            class="field__input"
            autocomplete="name"
            type="text"
            id="ContactForm-name"
            name="contact[{{ 'templates.contact.form.name' | t }}]"
            value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
            placeholder="{{ 'templates.contact.form.name' | t }}"
            required
            aria-required="true"
          >
          <label class="field__label" for="ContactForm-name">
            {{- 'templates.contact.form.name' | t }}
            <span aria-hidden="true">*</span></label
          >
        </div>
        <div class="field field--with-error">
          <input
            autocomplete="email"
            type="email"
            id="ContactForm-email"
            class="field__input"
            name="contact[email]"
            spellcheck="false"
            autocapitalize="off"
            value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
            aria-required="true"
            {% if form.errors contains 'email' %}
              aria-invalid="true"
              aria-describedby="ContactForm-email-error"
            {% endif %}
            placeholder="{{ 'templates.contact.form.email' | t }}"
          >
          <label class="field__label" for="ContactForm-email">
            {{- 'templates.contact.form.email' | t }}
            <span aria-hidden="true">*</span></label
          >
          {%- if form.errors contains 'email' -%}
            <small class="contact__field-error" id="ContactForm-email-error">
              <span class="visually-hidden">{{ 'accessibility.error' | t }}</span>
              <span class="form__message">
                <span class="svg-wrapper">
                  {{- 'icon-error.svg' | inline_asset_content -}}
                </span>
                {{- form.errors.translated_fields.email | capitalize }}
                {{ form.errors.messages.email -}}
              </span>
            </small>
          {%- endif -%}
        </div>
      </div>
      {%- liquid
        # Shopify emails every contact[...] field as "Key: value". Keys are fixed (not the
        # on-page labels) so the notification email stays consistent if the wording changes.
        # Project types come from the Service metaobjects: the ones picked in the section
        # settings (in that order), or every service if none are picked.
        if section.settings.services != blank and section.settings.services.count > 0
          assign services = section.settings.services
        else
          assign services = shop.metaobjects.service.values
        endif
        assign extra_project_types = section.settings.extra_project_types | newline_to_br | split: '<br />'
        assign budget_options = section.settings.budget_options | newline_to_br | split: '<br />'
        assign timeline_options = section.settings.timeline_options | newline_to_br | split: '<br />'
      -%}

      {%- if section.settings.show_company -%}
        <div class="field">
          <input
            type="text"
            id="ContactForm-company"
            class="field__input"
            autocomplete="organization"
            name="contact[Company]"
            placeholder="{{ section.settings.label_company | escape }}"
          >
          <label class="field__label" for="ContactForm-company">{{ section.settings.label_company | escape }}</label>
        </div>
      {%- endif -%}

      {%- if section.settings.show_project_type -%}
        <div class="contact__select-field contact__project-type">
          <label class="form__label" for="ContactForm-project-type">
            {{- section.settings.label_project_type | escape -}}
            {%- if section.settings.require_project_type %} <span aria-hidden="true">*</span>{% endif -%}
          </label>
          <div class="select">
            <select
              id="ContactForm-project-type"
              class="select__select"
              name="contact[Project type]"
              {% if section.settings.require_project_type %}required aria-required="true"{% endif %}
            >
              <option value="">{{ section.settings.select_placeholder | escape }}</option>
              {%- for service in services -%}
                {%- assign option_label = service.title.value | strip -%}
                {%- if option_label != blank -%}
                  <option value="{{ option_label | escape }}">{{ option_label | escape }}</option>
                {%- endif -%}
              {%- endfor -%}
              {%- for option in extra_project_types -%}
                {%- assign option_label = option | strip -%}
                {%- if option_label != blank -%}
                  <option value="{{ option_label | escape }}">{{ option_label | escape }}</option>
                {%- endif -%}
              {%- endfor -%}
            </select>
            <span class="svg-wrapper">{{- 'icon-caret.svg' | inline_asset_content -}}</span>
          </div>
        </div>
      {%- endif -%}

      {%- if section.settings.show_budget or section.settings.show_timeline -%}
        <div class="contact__fields contact__selects">
          {%- if section.settings.show_budget and section.settings.budget_options != blank -%}
            <div class="contact__select-field">
              <label class="form__label" for="ContactForm-budget">{{ section.settings.label_budget | escape }}</label>
              <div class="select">
                <select id="ContactForm-budget" class="select__select" name="contact[Budget]">
                  <option value="">{{ section.settings.select_placeholder | escape }}</option>
                  {%- for option in budget_options -%}
                    {%- assign option_label = option | strip -%}
                    {%- if option_label != blank -%}
                      <option value="{{ option_label | escape }}">{{ option_label | escape }}</option>
                    {%- endif -%}
                  {%- endfor -%}
                </select>
                <span class="svg-wrapper">{{- 'icon-caret.svg' | inline_asset_content -}}</span>
              </div>
            </div>
          {%- endif -%}
          {%- if section.settings.show_timeline and section.settings.timeline_options != blank -%}
            <div class="contact__select-field">
              <label class="form__label" for="ContactForm-timeline">{{ section.settings.label_timeline | escape }}</label>
              <div class="select">
                <select id="ContactForm-timeline" class="select__select" name="contact[Timeline]">
                  <option value="">{{ section.settings.select_placeholder | escape }}</option>
                  {%- for option in timeline_options -%}
                    {%- assign option_label = option | strip -%}
                    {%- if option_label != blank -%}
                      <option value="{{ option_label | escape }}">{{ option_label | escape }}</option>
                    {%- endif -%}
                  {%- endfor -%}
                </select>
                <span class="svg-wrapper">{{- 'icon-caret.svg' | inline_asset_content -}}</span>
              </div>
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}

      <div class="field">
        <textarea
          rows="8"
          id="ContactForm-body"
          class="text-area field__input"
          name="contact[{{ 'templates.contact.form.comment' | t }}]"
          placeholder="{{ section.settings.label_message | escape }}"
          {% if section.settings.require_message %}required aria-required="true"{% endif %}
        >
          {{- form.body -}}
        </textarea>
        <label class="form__label field__label" for="ContactForm-body">
          {{- section.settings.label_message | escape -}}
          {%- if section.settings.require_message %} <span aria-hidden="true">*</span>{% endif -%}
        </label>
      </div>
      <div class="contact__button">
        <button type="submit" class="button">
          {{ 'templates.contact.form.send' | t }}
        </button>
      </div>
    {%- endform -%}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.contact-form.name",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "default": "t:sections.contact-form.settings.title.default",
      "label": "t:sections.contact-form.settings.title.label"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h2",
          "label": "t:sections.all.heading_size.options__1.label"
        },
        {
          "value": "h1",
          "label": "t:sections.all.heading_size.options__2.label"
        },
        {
          "value": "h0",
          "label": "t:sections.all.heading_size.options__3.label"
        },
        {
          "value": "hxl",
          "label": "t:sections.all.heading_size.options__4.label"
        },
        {
          "value": "hxxl",
          "label": "t:sections.all.heading_size.options__5.label"
        }
      ],
      "default": "h1",
      "label": "t:sections.all.heading_size.label"
    },
    {
      "type": "header",
      "content": "Form fields"
    },
    {
      "type": "paragraph",
      "content": "Answers arrive in the contact notification email as Company, Project type, Budget and Timeline."
    },
    {
      "type": "checkbox",
      "id": "show_company",
      "default": true,
      "label": "Show company field"
    },
    {
      "type": "text",
      "id": "label_company",
      "default": "Company or website",
      "label": "Company label",
      "visible_if": "{{ section.settings.show_company }}"
    },
    {
      "type": "checkbox",
      "id": "show_project_type",
      "default": true,
      "label": "Show project type"
    },
    {
      "type": "text",
      "id": "label_project_type",
      "default": "What can we help with?",
      "label": "Project type label",
      "visible_if": "{{ section.settings.show_project_type }}"
    },
    {
      "type": "metaobject_list",
      "id": "services",
      "metaobject_type": "service",
      "limit": 25,
      "label": "Services",
      "info": "Listed as project type options, in this order. Leave empty to list every service.",
      "visible_if": "{{ section.settings.show_project_type }}"
    },
    {
      "type": "textarea",
      "id": "extra_project_types",
      "default": "Something else",
      "label": "Extra options",
      "info": "Added after the services, one per line",
      "visible_if": "{{ section.settings.show_project_type }}"
    },
    {
      "type": "checkbox",
      "id": "require_project_type",
      "default": true,
      "label": "Require project type",
      "visible_if": "{{ section.settings.show_project_type }}"
    },
    {
      "type": "checkbox",
      "id": "show_budget",
      "default": false,
      "label": "Show budget"
    },
    {
      "type": "text",
      "id": "label_budget",
      "default": "Budget",
      "label": "Budget label",
      "visible_if": "{{ section.settings.show_budget }}"
    },
    {
      "type": "textarea",
      "id": "budget_options",
      "default": "Under $10k\n$10k–$25k\n$25k–$50k\n$50k–$100k\n$100k+\nNot sure yet",
      "label": "Budget options",
      "info": "One per line",
      "visible_if": "{{ section.settings.show_budget }}"
    },
    {
      "type": "checkbox",
      "id": "show_timeline",
      "default": false,
      "label": "Show timeline"
    },
    {
      "type": "text",
      "id": "label_timeline",
      "default": "Timeline",
      "label": "Timeline label",
      "visible_if": "{{ section.settings.show_timeline }}"
    },
    {
      "type": "textarea",
      "id": "timeline_options",
      "default": "As soon as possible\n1–3 months\n3–6 months\n6+ months\nFlexible",
      "label": "Timeline options",
      "info": "One per line",
      "visible_if": "{{ section.settings.show_timeline }}"
    },
    {
      "type": "text",
      "id": "select_placeholder",
      "default": "Select one",
      "label": "Dropdown placeholder"
    },
    {
      "type": "text",
      "id": "label_message",
      "default": "Tell us about your project",
      "label": "Message label"
    },
    {
      "type": "checkbox",
      "id": "require_message",
      "default": false,
      "label": "Require message"
    },
    {
      "type": "header",
      "content": "t:sections.all.colors.label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    },
    {
      "type": "header",
      "content": "In-page navigation"
    },
    {
      "type": "text",
      "id": "anchor_id",
      "label": "Section ID",
      "info": "Optional. Link to this section with #your-id (e.g. #services). Use a unique ID per page."
    }
  ],
  "presets": [
    {
      "name": "t:sections.contact-form.presets.name"
    }
  ]
}
{% endschema %}
